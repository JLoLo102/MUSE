                    更新验证集指标：Top-1/5/10 Accuracy, Macro-F1, mAP, Precision@5
                    """

        self.model.eval()

        all_targets = []
        all_preds = []
        all_probs = []

        topk = (5, 10)
        correct_topk = {k: 0 for k in topk}
        total_samples = 0
        all_loss = 0.0


        for _, data in enumerate(self.val_loader, 0):
            if self.model_name == 'MUSE':
                N, V, C, H, W = data[1].size()
                in_data = data[1].view(-1, C, H, W).cuda()
            else:
                in_data = data[1].cuda()

