def mmrl_loss_full(logits_c, logits_r, labels, fc, f0, wt, w0,
                   lambda_cos=0.5, alpha=0.7):

    # ===== 分类损失 =====
    loss_c = F.cross_entropy(logits_c, labels)
    loss_r = F.cross_entropy(logits_r, labels)

    # ===== 图像 cosine =====
    fc = F.normalize(fc, dim=-1)
    f0 = F.normalize(f0, dim=-1)
    loss_v = 1 - (fc * f0).sum(dim=-1).mean()

    # ===== 文本 cosine（新增）=====
    wt = F.normalize(wt, dim=-1)
    w0 = F.normalize(w0, dim=-1)
    loss_t = 1 - (wt * w0).sum(dim=-1).mean()

    # ===== 总损失 =====
    loss = alpha * loss_c + (1 - alpha) * loss_r \
           + lambda_cos * (loss_v + loss_t)

    return loss

def build_knowledge_tensor(data):
    obs_paths, reasoning_paths, intent_paths, category_paths = data
    B = len(obs_paths)

    obs_list = []
    reasoning_list = []
    intent_list = []
    cate_list = []

    for i in range(B):
        obs_list.append(torch.load(obs_paths[i])['embedding'])
        reasoning_list.append(torch.load(reasoning_paths[i])['embedding'])
        intent_list.append(torch.load(intent_paths[i])['embedding'])
        cate_list.append(torch.load(category_paths[i])['embedding'])

    # [B, 2560]
    obs_tensor = torch.stack(obs_list, dim=0)
    reasoning_tensor = torch.stack(reasoning_list, dim=0)
    intent_tensor = torch.stack(intent_list, dim=0)
    cate_tensor = torch.stack(cate_list, dim=0)

    # [B, 4, 2560]
    knowledge = torch.stack(
        [obs_tensor, reasoning_tensor, intent_tensor, cate_tensor],
        dim=1
    )

    return knowledge

def symmetric_kl(p, q, T=1.0):
    """
    p, q: [B, D]
    """
    p_log = F.log_softmax(p / T, dim=-1)
    q_log = F.log_softmax(q / T, dim=-1)

    p_prob = F.softmax(p / T, dim=-1)
    q_prob = F.softmax(q / T, dim=-1)

    kl_pq = F.kl_div(p_log, q_prob, reduction='batchmean')
    kl_qp = F.kl_div(q_log, p_prob, reduction='batchmean')

    return (kl_pq + kl_qp) / 2

def cosine_loss(p, q):
    p = F.normalize(p, dim=-1)
    q = F.normalize(q, dim=-1)
    return 1 - (p * q).sum(dim=-1).mean()

def mutual_prediction_loss(
        visual_logits,
        knowledge_logits,
        T=2.0
):

    visual_prob = F.softmax(
        visual_logits/T,
        dim=-1
    )

    knowledge_prob = F.softmax(
        knowledge_logits/T,
        dim=-1
    )


    loss_vk = F.kl_div(
        F.log_softmax(visual_logits/T,dim=-1),
        knowledge_prob,
        reduction='batchmean'
    )


    loss_kv = F.kl_div(
        F.log_softmax(knowledge_logits/T,dim=-1),
        visual_prob,
        reduction='batchmean'
    )


    return (loss_vk + loss_kv)/2*T*T

def load_pretrained(model, path):
