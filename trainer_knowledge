class KnowledgeAdvantage(nn.Module):

    def __init__(self,dim=768):

        super().__init__()

        self.net=nn.Sequential(

            nn.Linear(dim*2+1,512),

            nn.GELU(),

            nn.Linear(512,128),

            nn.GELU(),

            nn.Linear(128,1)

        )

    def forward(self,visual,knowledge,similarity):

        # similarity=similarity.mean(
        #
        #     dim=1,
        #
        #     keepdim=True
        #
        # )
        similarity, _ = torch.max(similarity,dim=1,keepdim=True)

        x=torch.cat(

            [

                visual,

                knowledge,

                similarity

            ],

            dim=-1

        )

        return torch.sigmoid(

            self.net(x)

        )

