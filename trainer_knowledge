def freeze_module(module):
    for p in module.parameters():
        p.requires_grad = False

class KnowledgeFilter(nn.Module):

    def __init__(self,dim=768):

        super().__init__()

        self.net=nn.Sequential(

            nn.Linear(dim*2+1,512),

            nn.ReLU(),

            nn.Linear(512,128),

            nn.ReLU(),

            nn.Linear(128,1)

        )

    def forward(

            self,

            visual_feat,

            knowledge_feat,

            similarity

    ):

        """
        visual_feat

            [B,768]

        knowledge_feat

            [B,K,4,768]

        similarity

            [B,K]

        """

        B,K,T,D = knowledge_feat.shape

        # ---------- visual ----------
        visual_feat = visual_feat.unsqueeze(1)

        visual_feat = visual_feat.unsqueeze(2)

        visual_feat = visual_feat.expand( -1,K,T,-1)

        # ---------- similarity ----------

        similarity = similarity.unsqueeze(-1)

        similarity = similarity.unsqueeze(-1)

        similarity = similarity.expand(-1, -1,T,-1)

        score=self.net(

            torch.cat(

                [

                    visual_feat,

                    knowledge_feat,

                    similarity

                ],

                dim=-1

            )

        )

        return torch.sigmoid(score)

class CrossAttentionFusion(nn.Module):
    """
    Knowledge-guided Cross-Attention Residual Fusion
    """

    def __init__(self, dim=768, num_heads=8, dropout=0.1, gamma=0.2):
        super(CrossAttentionFusion, self).__init__()

        self.dim = dim
        self.gamma = gamma

        self.attn = nn.MultiheadAttention(
            embed_dim=dim,
            num_heads=num_heads,
            dropout=dropout,
            batch_first=True
        )

        self.norm = nn.LayerNorm(dim)

        # optional learnable gate（比固定gamma更好）
        self.gate = nn.Sequential(
            nn.Linear(dim, dim),
            nn.ReLU(),
            nn.Linear(dim, 1),
            nn.Sigmoid()
        )

    def forward(
            self,
            image_feat,
            knowledge_feat,
            knowledge_weight
    ):
        if image_feat.dim() == 2:
            image_feat = image_feat.unsqueeze(1)

        knowledge_feat = knowledge_feat * knowledge_weight

        attn_out, _ = self.attn(

            query=image_feat,

            key=knowledge_feat,

            value=knowledge_feat

        )

        gate = self.gate(image_feat)

        out = image_feat + gate * attn_out

        out = self.norm(out)

        return out.squeeze(1)

