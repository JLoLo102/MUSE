    def retrieve_knowledge(
            self,
            query_feat,
            topk=10,
            threshold=0.75
    ):

        query_feat = F.normalize(query_feat, dim=-1)

        similarity = torch.matmul(
            query_feat,
            self.memory_visual.t()
        )

        score, index = torch.topk(
            similarity,
            topk,
            dim=1
        )

        retrieved = []

        similarity_list = []

        for i in range(query_feat.size(0)):

            keep = score[i] > threshold

            if keep.sum() == 0:
                keep[0] = True

            knowledge = self.memory_knowledge[
                index[i][keep]
            ]

            sim = score[i][keep]

            retrieved.append(knowledge)

            similarity_list.append(sim)

        maxk = max([k.size(0) for k in similarity_list])

        knowledge_pad = []

        sim_pad = []

        for k, s in zip(retrieved, similarity_list):

            pad = maxk - k.size(0)

            if pad > 0:
                k = F.pad(
                    k,
                    (0, 0, 0, 0, 0, pad)
                )

                s = F.pad(
                    s,
                    (0, pad)
                )

            knowledge_pad.append(k)

            sim_pad.append(s)

        return torch.stack(
            knowledge_pad
        ), torch.stack(
            sim_pad
        )

